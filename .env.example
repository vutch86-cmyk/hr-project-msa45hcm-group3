# ==========================================
# CẤU HÌNH HỆ THỐNG HR MANAGEMENT WITH AI
# ==========================================

# Môi trường: development | staging | production
ENVIRONMENT=development
PROJECT_NAME="HR Management with AI"
API_V1_PREFIX="/api/v1"

# Cấu hình CSDL PostgreSQL
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=hr_user
POSTGRES_PASSWORD=hr_secret_password
POSTGRES_DB=hr_management_db

# Chuỗi kết nối Database (SQLAlchemy Async và Sync cho Alembic)
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}
SYNC_DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# Bảo mật & JWT
SECRET_KEY=change_this_to_a_very_secure_random_string_32_bytes_minimum
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# Token bảo mật dành riêng cho Kiosk Web (quét thẻ QR)
KIOSK_API_SECRET_KEY=kiosk_secret_device_authorization_token_hr_group3

# Trí tuệ nhân tạo (Google Gemini)
# Opt-in only; fallback works without Gemini.
GEMINI_ENABLED=false
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-3.5-flash-lite
# Optional: rotate text models to spread per-model quota (comma-separated; empty = GEMINI_MODEL_NAME only)
GEMINI_MODEL_POOL=gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_MODEL_RPM=15
GEMINI_INTENT_TIMEOUT_SECONDS=15
GEMINI_POLICY_TIMEOUT_SECONDS=15
# Each flag below sends user text to Google; leave false unless approved.
GEMINI_SEMANTIC_ENABLED=false
GEMINI_PUBLIC_SEARCH_ENABLED=false
GEMINI_PUBLIC_SEARCH_TIMEOUT_SECONDS=10
# Hybrid RAG: embeds published knowledge chunks and masked questions (no employee records).
GEMINI_EMBEDDINGS_ENABLED=false
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBED_TIMEOUT_SECONDS=8
# Sends uploaded PDF files to Gemini when they are scanned or have no detectable headings.
GEMINI_PDF_STRUCTURE_ENABLED=false
GEMINI_PDF_TIMEOUT_SECONDS=90
# Labels published passages as prohibition/obligation/permission for policy warnings.
GEMINI_KNOWLEDGE_TAGGING_ENABLED=false
AI_KNOWLEDGE_VECTOR_MAX_DISTANCE=0.5
AI_CHAT_TIMEOUT_SECONDS=30
AI_KNOWLEDGE_STORAGE_DIR=storage/private/ai-knowledge
AI_KNOWLEDGE_MAX_UPLOAD_BYTES=10485760
REPORT_STORAGE_DIR=storage/private/reports

# CORS (Frontend React)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Google Login (Backend)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Frontend Vite Proxy (nếu dùng chung root, cho file frontend/.env)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Microsoft Entra SSO (single tenant; runtime settings, no client secret)
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
